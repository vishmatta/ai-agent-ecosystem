  "description": "Subtitle line under a page title: a drafted deck, or a visibly distinct not-yet-drafted note.",
  "type": "module",
  "private": true,
  "main": "./index.js",
  "exports": {
    ".": { "import": "./index.js" },
    "./components": { "import": "./components/index.js" },
