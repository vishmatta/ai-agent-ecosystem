{
  "name": "agent-ecosystem-stage-nav",
  "version": "1.0.0",
  "description": "Top-level stage navigation: Build → Connect → Run as a pipeline, with Control as a separate cross-cutting tab.",
  "type": "module",
  "private": true,
  "main": "./index.js",
  "exports": {
    ".": { "import": "./index.js" },
    "./components": { "import": "./components/index.js" },
    "./package.json": "./package.json"
  },
  "quartz": {
    "name": "agent-ecosystem-stage-nav",
    "displayName": "Stage Nav",
    "description": "Build → Connect → Run pipeline plus Control, with the current stage marked.",
    "version": "1.0.0",
    "quartzVersion": ">=5.0.0",
    "category": "component",
    "dependencies": [],
    "defaultEnabled": true,
    "defaultOptions": {},
    "components": {
      "StageNav": {
        "name": "agent-ecosystem-stage-nav",
        "displayName": "Stage Nav",
        "description": "Top-level taxonomy stage navigation.",
        "version": "1.0.0",
        "defaultPosition": "beforeBody",
        "defaultPriority": 1
      }
